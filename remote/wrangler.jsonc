{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "newgit",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The UI and the API, at the apex. Previews get <id>.newgit.dev (docs/design/remote.md, *Auth*).
  "routes": [{ "pattern": "newgit.dev", "custom_domain": true }],
  "workers_dev": true,
  // scripts/install.sh, served at /install.sh.
  "rules": [{ "type": "Text", "globs": ["**/*.sh"] }],
  // One namespace for every project; repo names carry the project as a
  // prefix. A binding names exactly one namespace (docs/design/remote.md).
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "newgit" }],
  "durable_objects": {
    "bindings": [
      { "class_name": "ProjectDO", "name": "PROJECTS" },
      // One per tracker path: its heads, log, inbox, and outbox (src/tracker-do.ts).
      { "class_name": "TrackerDO", "name": "TRACKERS" },
      { "class_name": "UserDO", "name": "USERS" },
      // One per project: the Git endpoint's container (src/endpoint.ts).
      { "class_name": "GitEndpoint", "name": "ENDPOINTS" },
      // One instance: the spend kill switch's state (src/budget.ts).
      { "class_name": "BudgetDO", "name": "BUDGET" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProjectDO"] },
    { "tag": "v2", "new_sqlite_classes": ["UserDO"] },
    { "tag": "v3", "new_sqlite_classes": ["GitEndpoint"] },
    { "tag": "v4", "new_sqlite_classes": ["BudgetDO"] },
    { "tag": "v5", "new_sqlite_classes": ["TrackerDO"] }
  ],
  // Hourly: check the last 7 days' spend against the weekly budget (src/budget.ts).
  "triggers": { "crons": ["0 * * * *"] },
  // Real git and newgit, built from this repository (endpoint.Dockerfile).
  "containers": [
    {
      "class_name": "GitEndpoint",
      "scheduling_policy": "durable_object",
      "images": { "endpoint": { "dockerfile": "./endpoint.Dockerfile", "build_context": ".." } }
    }
  ],
  "vars": {
    // A public value: GitHub's device flow identifies the app by it.
    "GITHUB_CLIENT_ID": "Ov23liKp3f44HWjSOE9L",
    // Where the namespace's repos are served; not a secret.
    // The account the spend kill switch reads billing for; not a secret.
    "CLOUDFLARE_ACCOUNT_ID": "bce0b38de721f350c8d8a51d0520337d",
    "ARTIFACTS_GIT_BASE": "https://bce0b38de721f350c8d8a51d0520337d.artifacts.cloudflare.net/git/newgit",
    // The site, read from trackers at their trunk (src/site.ts). `site` is
    // secret, so naming its files here is what publishes them: the landing
    // page at /, and the template every wiki page is poured into. The wiki's
    // words are root's Markdown in docs/wiki, at /docs/<page>.
    "SITE": {
      "project": "spheroman/newgit",
      "landing": { "tracker": "site", "path": "remote/site/index.html" },
      "docs": {
        "tracker": "root",
        "dir": "docs/wiki",
        "template": { "tracker": "site", "path": "remote/site/page.html" },
        "source": "https://github.com/Spheroman/newgit/blob/main"
      }
    }
  },
  // A remote of its own for trying changes before they merge: its own
  // Worker, Artifacts namespace, Durable Objects, and container, on
  // workers.dev and nowhere near newgit.dev. `remote/scripts/dev.sh` deploys
  // it from the working tree (docs/design/remote.md, *A dev remote*). Bindings
  // are not inherited by an environment, so each is repeated here.
  "env": {
    "dev": {
      "name": "newgit-dev",
      "routes": [],
      "workers_dev": true,
      "artifacts": [{ "binding": "ARTIFACTS", "namespace": "newgit-dev" }],
      "durable_objects": {
        "bindings": [
          { "class_name": "ProjectDO", "name": "PROJECTS" },
      // One per tracker path: its heads, log, inbox, and outbox (src/tracker-do.ts).
      { "class_name": "TrackerDO", "name": "TRACKERS" },
          { "class_name": "UserDO", "name": "USERS" },
          { "class_name": "GitEndpoint", "name": "ENDPOINTS" },
          { "class_name": "BudgetDO", "name": "BUDGET" }
        ]
      },
      "triggers": { "crons": [] },
      "containers": [
        {
          "class_name": "GitEndpoint",
          "scheduling_policy": "durable_object",
          "images": { "endpoint": { "dockerfile": "./endpoint.Dockerfile", "build_context": ".." } }
        }
      ],
      "vars": {
        "GITHUB_CLIENT_ID": "Ov23liKp3f44HWjSOE9L",
        "CLOUDFLARE_ACCOUNT_ID": "bce0b38de721f350c8d8a51d0520337d",
        "ARTIFACTS_GIT_BASE": "https://bce0b38de721f350c8d8a51d0520337d.artifacts.cloudflare.net/git/newgit-dev",
        // Opens `POST /v1/dev/login` (with the DEV_LOGIN_SECRET secret). Never on prod.
        "DEV_REMOTE": "1"
      }
    }
  },
  // Secrets: TOKEN_KEY (signs newgit tokens), ALLOWED_LOGINS (who may use
  // this remote; unset admits no one), BLOCKED_LOGINS (who may not, even
  // under `*`), ADMIN_LOGINS (may delete any project, and are not capped),
  // PROJECTS_PER_LOGIN (unset is 5). See docs/design/remote.md, *Identity And Tokens*.
  // BILLING_TOKEN (an API token with Billing: Read; unset turns the spend
  // kill switch off), SPEND_LIMIT_WEEKLY_USD (unset is 10).
  // GITHUB_WEBHOOK_SECRET (signs GitHub's webhook events; unset answers 503).
}
